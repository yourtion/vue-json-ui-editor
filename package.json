{
  "name": "vue-json-ui-editor",
  "version": "3.2.0",
  "description": "A Vue 3 JSON Schema based form editor component with TypeScript support",
  "type": "module",
  "main": "dist/vue-json-ui-editor.umd.cjs",
  "module": "dist/vue-json-ui-editor.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/vue-json-ui-editor.es.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/vue-json-ui-editor.umd.cjs"
      }
    }
  },
  "files": [
    "dist",
    "SCHEMA_SUPPORT.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build:lib": "vue-tsc && vite build --mode lib",
    "preview": "vite preview",
    "test": "vitest run",
    "test:package": "npm run build:lib && npm run test:package:consumers",
    "test:package:consumers": "node scripts/check-package.mjs",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "type-check": "vue-tsc --noEmit",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "check": "npm run type-check && npm run lint && npm run test",
    "prepublishOnly": "npm run check && npm run test:release && npm run build:lib && npm run test:package:consumers",
    "lint:fix": "biome check --write src/",
    "test:release": "node --test scripts/npm-release.test.mjs",
    "mutation": "stryker run",
    "mutation:full": "stryker run --force"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "3.2.7",
    "@vitest/ui": "3.2.7",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "element-plus": "^2.11.1",
    "jsdom": "^23.0.0",
    "postcss-import": "^16.1.1",
    "typescript": "5.6.2",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.6.0",
    "vitest": "3.2.7",
    "vue": "^3.5.0",
    "vue-tsc": "2.0.29",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0"
  },
  "peerDependencies": {
    "vue": "^3"
  },
  "keywords": [
    "vue",
    "vue3",
    "typescript",
    "json-schema",
    "form-editor",
    "ui-component",
    "vite"
  ],
  "author": "Yourtion <yourtion@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourtion/vue-json-ui-editor.git"
  },
  "bugs": {
    "url": "https://github.com/yourtion/vue-json-ui-editor/issues"
  },
  "homepage": "https://github.com/yourtion/vue-json-ui-editor#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.com/"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2"
  },
  "packageManager": "pnpm@10.34.7"
}
